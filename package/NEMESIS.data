[nemesis]
version=1.1
id=realtek.88x2bu
name=Realtek RTL8812BU USB Driver
type=application,service
package-version=1.1.5
short-desc=USB Wi-Fi driver with startup preload for Gen5W
detailed-desc=Loads 88x2bu at startup. Launch from My Packages to check a supported USB dongle. Supports TCC803x and TCC897x with Linux 3.18.24-tcc.
depends=!usbwifi.hotspot
preinstall=scripts/preinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=scripts/load.sh
uid=root

[service.0]
name=preload
kind=sh
path=scripts/boot.sh
uid=root
mode=background
