[nemesis]
version=1.1
id=realtek.88x2bu
name=Realtek RTL8812BU USB Driver
type=application,service
package-version=1.1.6
short-desc=USB Wi-Fi driver with automatic NEMESIS Launch for Gen5W
detailed-desc=Runs the NEMESIS Launch action automatically after Android boots. Launch from My Packages to check a USB dongle. Supports TCC803x and TCC897x with Linux 3.18.24-tcc.
depends=!usbwifi.hotspot
preinstall=scripts/preinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=scripts/load.sh
uid=root

[service.0]
name=preload
kind=sh
path=scripts/boot.sh
uid=root
mode=restart
